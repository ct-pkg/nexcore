#include <stdint.h>

namespace js_backend;

/*
 * JS 后端接口（P1 只有空实现；P2 换成 QuickJS 实现，调用点不变）。
 *
 * 线程约定：句柄只在调用方线程使用（P1 没有 worker 线程），本单元内部不引入锁。
 */
pub void *init(const char *bootstrap_js, int32_t bootstrap_len);

/*
 * 把 src 当作 JS 表达式求值，结果以 malloc 缓冲返回，调用方负责 free。
 * 空实现下恒返回 -1，且不写 *out / *out_len。
 */
pub int32_t eval(void *h, const char *src, int32_t len, char **out, int32_t *out_len);

pub int32_t shutdown(void *h);

pub int32_t turns(void);

/*
 * 把 runtime 的 job 队列泵到空，或泵满 max_jobs 个（max_jobs <= 0 视为「泵到空」）。
 * 返回实际执行 job 数（>= 0）；出错返回 -1。job 内的异常不得穿透到调用方。
 *
 * 空实现恒返回 0。实现单元（quickjs）在 eval 成功后必须调用 pump(h, 0)，
 * 宿主因此只需 send + drain 就能观察到 Promise 回调，不必新增导出符号。
 */
pub int32_t pump(void *h, int32_t max_jobs);
