#include <stdint.h>
#include <stddef.h>

/* 回调形状（与 ABI 的 NexCoreNativeCall 逐字段同型）。必须是 pub：生成器只导出 pub 声明，
 * 放在 namespace 之外是为了让名字保持原样、不被加单元前缀。 */
pub typedef int32_t (*NxNativeCallFn)(void *user,
                                      const char *name, size_t name_len,
                                      const char *args_json, size_t args_len,
                                      char **out_json, size_t *out_len);

namespace js_backend;

/*
 * JS 后端接口（P1 只有空实现；P2 换成 QuickJS 实现，调用点不变）。
 *
 * 线程约定：句柄只在调用方线程使用（P1 没有 worker 线程），本单元内部不引入锁。
 *
 * native_call 的形状与 ABI 的 NexCoreNativeCall 逐字段同型；用文件顶部的
 * NxNativeCallFn（pub 且置于 namespace 之外，生成器不加前缀）。
 * native_* 四个参数来自 NexCoreConfig 的尾字段，调用方已保证 struct_size 覆盖到它们；
 * 全为 0 表示不注册任何原生能力。
 */
pub void *init(const char *bootstrap_js, int32_t bootstrap_len,
               NxNativeCallFn native_call, void *native_user,
               const char *native_names, int32_t native_names_len);

/*
 * 把 src 当作 JS 表达式求值，结果以 malloc 缓冲返回，调用方负责 free。
 * 空实现下恒返回 -1，且不写 *out / *out_len。
 */
pub int32_t eval(void *h, const char *src, int32_t len, int32_t mode, char **out, int32_t *out_len);

pub int32_t shutdown(void *h);

/*
 * 自上次调用以来累计的 job 执行数与未处理 Promise 拒绝数。
 * 替换原来的 turns()（无调用者的僵尸方法，PH-10 C7）：NexCore 的
 * NX_STAT_JS_JOBS / NX_STAT_JS_EXCEPTIONS 由此采样，不再是常量 0。
 */
pub void stats(void *h, int64_t *jobs, int64_t *exceptions);

/*
 * 把 runtime 的 job 队列泵到空，或泵满 max_jobs 个（max_jobs <= 0 视为「泵到空」）。
 * 返回实际执行 job 数（>= 0）；出错返回 -1。job 内的异常不得穿透到调用方。
 *
 * 空实现恒返回 0。实现单元（quickjs）在 eval 成功后必须调用 pump(h, 0)，
 * 宿主因此只需 send + drain 就能观察到 Promise 回调，不必新增导出符号。
 */
pub int32_t pump(void *h, int32_t max_jobs);
