#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include "quickjs.h"

import js_backend_quickjs;

namespace js_backend;

/*
 * QuickJS 实现（非注册单元）。与 js_backend.ct 的空实现同命名空间、同目录，
 * 构建期只编其中一个：null 档编 js_backend.ct，quickjs 档编本文件。
 *
 * 约束来源（实测）：
 *   - 换目录会报 `namespace does not match the directory`；
 *   - 换文件名会红在 ⑤a（首段 import 必须是自己的 .h.ct）。
 * 所以这里是「同目录第二实现」，不是独立单元。
 */

#define NXJB_OK 0
#define NXJB_ERR -1
/* job 内抛错：与普通求值失败区分，调用方据此累加 JS_EXCEPTIONS（红队 A6）。 */
#define NXJB_JOB_THREW -2

/* job 队列有界泵的硬上限：自续链（job 里再排 job）必须停下来。 */
#define NXJB_PUMP_CAP 10000

/* 求值模式（与 ABI 的 NxEvalMode 同值；0 是表达式，保持缺省语义）。 */
#define NXJB_MODE_PROGRAM 1

/* 只在本单元内使用：runtime/context 的生命周期由 init/shutdown 成对管理。 */
struct BackendState {
    JSRuntime *rt;
    JSContext *ctx;
    int32_t (*native_call)(void *user, const char *name, size_t name_len,
                           const char *args_json, size_t args_len,
                           char **out_json, size_t *out_len);
    void *native_user;
    const char *native_names;
    int32_t native_names_len;
    char **names;
    int32_t names_count;
    int64_t jobs;
    int64_t exceptions;
    int32_t (*interrupt_call)(void *user);
    void *interrupt_user;
    int32_t timeout_ms;
    int64_t eval_start;
    int32_t interrupt_reason;
}

/*
 * 原生能力（PH-10）：C 侧只暴露一个 `__nx_native(name, argsJson)`，
 * 其余挂载逻辑放在 JS 里做——避免在 C 里走 `A.B.C` 路径与取/建对象的样板。
 * 名字挂完不删除 helper：挂上的闭包捕获了 `__nx_native` 的全局名，删了会断。
 */
static const char *NXJB_NATIVE_INSTALL_JS =
    "var __nx_names=[];"
    "try{__nx_names=JSON.parse(__nx_native_names);}catch(e){__nx_names=[];}"
    "for(var __nx_i=0;__nx_i<__nx_names.length;__nx_i++){(function(nm){"
    "var p=nm.split('.');var o=globalThis;"
    "for(var k=0;k<p.length-1;k++){if(typeof o[p[k]]==='undefined'||o[p[k]]===null){o[p[k]]={};}o=o[p[k]];}"
    "o[p[p.length-1]]=(function(n){return function(){"
    "return __nx_native(n,JSON.stringify(Array.prototype.slice.call(arguments)));};})(nm);"
    "})(__nx_names[__nx_i]);}";

static JSValue js_native_call(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv);
static int js_interrupt(JSRuntime *rt, void *opaque);
static int64_t now_ms(void);

static void free_state(struct BackendState *st)
{
    int32_t i;

    if (st == 0) return;
    for (i = 0; i < st->names_count; i++) {
        free(st->names[i]);
    }
    free(st->names);
    if (st->ctx != 0) JS_FreeContext(st->ctx);
    if (st->rt != 0) JS_FreeRuntime(st->rt);
    free(st);
}

/*
 * 把 native_names（JSON 字符串数组）拷贝成 C 数组：宿主可以在 create 返回后释放原缓冲。
 * 解析失败返回 -1（异常已清）。
 */
static int32_t copy_names(struct BackendState *st)
{
    JSValue arr;
    JSValue item;
    JSValue ex;
    const char *s;
    int32_t count;
    int32_t i;

    st->names = 0;
    st->names_count = 0;
    arr = JS_ParseJSON(st->ctx, st->native_names, (size_t)st->native_names_len, "<native_names>");
    if (JS_IsException(arr)) {
        ex = JS_GetException(st->ctx);
        JS_FreeValue(st->ctx, ex);
        return NXJB_ERR;
    }
    count = 0;
    while (1) {
        item = JS_GetPropertyUint32(st->ctx, arr, (uint32_t)count);
        if (JS_IsUndefined(item)) {
            JS_FreeValue(st->ctx, item);
            break;
        }
        JS_FreeValue(st->ctx, item);
        count = count + 1;
    }
    if (count == 0) {
        JS_FreeValue(st->ctx, arr);
        return 0;
    }
    st->names = calloc((size_t)count, sizeof(char *));
    if (st->names == 0) {
        JS_FreeValue(st->ctx, arr);
        return NXJB_ERR;
    }
    for (i = 0; i < count; i++) {
        item = JS_GetPropertyUint32(st->ctx, arr, (uint32_t)i);
        s = JS_ToCString(st->ctx, item);
        JS_FreeValue(st->ctx, item);
        if (s == 0) {
            JS_FreeValue(st->ctx, arr);
            return NXJB_ERR;
        }
        st->names[i] = malloc(strlen(s) + 1);
        if (st->names[i] != 0) {
            memcpy(st->names[i], s, strlen(s) + 1);
            st->names_count = i + 1;
        }
        JS_FreeCString(st->ctx, s);
    }
    JS_FreeValue(st->ctx, arr);
    return 0;
}

/* 派发点的白名单校验：全名精确匹配。 */
static int32_t name_allowed(struct BackendState *st, const char *name, size_t len)
{
    int32_t i;

    for (i = 0; i < st->names_count; i++) {
        if (strlen(st->names[i]) == len && memcmp(st->names[i], name, len) == 0) return 1;
    }
    return 0;
}

/*
 * 把 `__nx_native` / `__nx_native_names` 装进 context，再跑挂载脚本。
 * 返回 0 成功（含「未提供 provider」），-1 失败（异常已清）。
 */
static int32_t install_natives(struct BackendState *st)
{
    JSValue g;
    JSValue v;
    JSAtom atom;

    if (st->native_call == 0) return 0;
    if (st->native_names == 0 || st->native_names_len <= 0) return 0;
    if (copy_names(st) != 0) return NXJB_ERR;
    if (st->names_count <= 0) return 0;
    JS_SetContextOpaque(st->ctx, st);
    g = JS_GetGlobalObject(st->ctx);
    JS_SetPropertyStr(st->ctx, g, "__nx_native",
                      JS_NewCFunction(st->ctx, js_native_call, "__nx_native", 2));
    JS_SetPropertyStr(st->ctx, g, "__nx_native_names",
                      JS_NewStringLen(st->ctx, st->native_names, (size_t)st->native_names_len));
    JS_FreeValue(st->ctx, g);
    v = JS_Eval(st->ctx, NXJB_NATIVE_INSTALL_JS, strlen(NXJB_NATIVE_INSTALL_JS),
                "<natives>", JS_EVAL_TYPE_GLOBAL);
    if (JS_IsException(v)) {
        v = JS_GetException(st->ctx);
        JS_FreeValue(st->ctx, v);
        return NXJB_ERR;
    }
    JS_FreeValue(st->ctx, v);
    /* 清单挂完即撤：脚本读不到白名单本身，但仍可调 __nx_native（入口会校验）。 */
    g = JS_GetGlobalObject(st->ctx);
    atom = JS_NewAtom(st->ctx, "__nx_native_names");
    JS_DeleteProperty(st->ctx, g, atom, 0);
    JS_FreeAtom(st->ctx, atom);
    JS_FreeValue(st->ctx, g);
    return 0;
}

static JSValue js_native_call(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)
{
    struct BackendState *st;
    const char *name;
    const char *args;
    size_t name_len;
    size_t args_len;
    char *out;
    size_t out_len;
    JSValue ret;
    int32_t rc;

    (void)this_val;
    st = JS_GetContextOpaque(ctx);
    if (st == 0 || st->native_call == 0) return JS_ThrowTypeError(ctx, "native provider not installed");
    if (argc < 2) return JS_ThrowTypeError(ctx, "native call: bad arguments");
    name = JS_ToCStringLen(ctx, &name_len, argv[0]);
    if (name == 0) return JS_EXCEPTION;
    args = JS_ToCStringLen(ctx, &args_len, argv[1]);
    if (args == 0) {
        JS_FreeCString(ctx, name);
        return JS_EXCEPTION;
    }
    if (!name_allowed(st, name, name_len)) {
        JS_FreeCString(ctx, name);
        JS_FreeCString(ctx, args);
        return JS_ThrowTypeError(ctx, "native call: name not registered");
    }
    out = 0;
    out_len = 0;
    rc = st->native_call(st->native_user, name, name_len, args, args_len, &out, &out_len);
    JS_FreeCString(ctx, name);
    JS_FreeCString(ctx, args);
    if (rc != 0 || out == 0) {
        if (out != 0) free(out);
        return JS_ThrowTypeError(ctx, "native call failed");
    }
    ret = JS_ParseJSON(ctx, out, out_len, "<native>");
    free(out);
    return ret;
}

/*
 * 未处理 Promise 拒绝的计数（E1d）：QuickJS 把 job 内的 throw 变成「被拒绝的 Promise」，
 * 不会让 JS_ExecutePendingJob 返回错误，因此必须用 host 拒绝追踪器采样。
 */
static void on_rejection(JSContext *ctx, JSValueConst promise, JSValueConst reason,
                         JS_BOOL is_handled, void *opaque)
{
    struct BackendState *st;

    (void)ctx;
    (void)promise;
    (void)reason;
    st = opaque;
    if (st != 0 && !is_handled) st->exceptions = st->exceptions + 1;
}

void *init(const char *bootstrap_js, int32_t bootstrap_len,
           int32_t (*native_call)(void *user, const char *name, size_t name_len,
                                  const char *args_json, size_t args_len,
                                  char **out_json, size_t *out_len),
           void *native_user, const char *native_names, int32_t native_names_len,
           int32_t (*interrupt_call)(void *user), void *interrupt_user,
           int32_t timeout_ms)
{
    struct BackendState *st;
    JSValue v;

    st = malloc(sizeof(struct BackendState));
    if (st == 0) return 0;
    st->rt = 0;
    st->ctx = 0;
    st->native_call = native_call;
    st->native_user = native_user;
    st->native_names = native_names;
    st->native_names_len = native_names_len;
    st->jobs = 0;
    st->exceptions = 0;
    st->interrupt_call = interrupt_call;
    st->interrupt_user = interrupt_user;
    st->timeout_ms = timeout_ms;
    st->eval_start = now_ms();
    st->interrupt_reason = 0;
    st->rt = JS_NewRuntime();
    if (st->rt == 0) {
        free(st);
        return 0;
    }
    JS_SetHostPromiseRejectionTracker(st->rt, on_rejection, st);
    /* K-4：求值期间轮询宿主钩子与预算，二者都走这条中断路径。 */
    JS_SetInterruptHandler(st->rt, js_interrupt, st);
    st->ctx = JS_NewContext(st->rt);
    if (st->ctx == 0) {
        free_state(st);
        return 0;
    }
    if (install_natives(st) != 0) {
        free_state(st);
        return 0;
    }
    if (bootstrap_js != 0 && bootstrap_len > 0) {
        v = JS_Eval(st->ctx, bootstrap_js, (size_t)bootstrap_len,
                    "<bootstrap>", JS_EVAL_TYPE_GLOBAL);
        if (JS_IsException(v)) {
            /* 清掉挂起的异常，避免后续 eval 读到脏状态。 */
            v = JS_GetException(st->ctx);
            JS_FreeValue(st->ctx, v);
            free_state(st);
            return 0;
        }
        JS_FreeValue(st->ctx, v);
    }
    return st;
}

/* 毫秒级单调时钟：预算约束的是求值占用，不包含宿主等待。 */
static int64_t now_ms(void)
{
    struct timespec ts;

    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000 + (int64_t)(ts.tv_nsec / 1000000);
}

/*
 * 引擎中断回调：宿主钩子优先，其次预算。返回 1 让 JS 中止当前求值。
 * 原因记在 state 里，供 eval 的异常路径给出可判定文案（K-4）。
 */
static int js_interrupt(JSRuntime *rt, void *opaque)
{
    struct BackendState *st;

    (void)rt;
    st = opaque;
    if (st == 0) return 0;
    if (st->interrupt_call != 0 && st->interrupt_call(st->interrupt_user) != 0) {
        st->interrupt_reason = 1;
        return 1;
    }
    if (st->timeout_ms > 0 && now_ms() - st->eval_start > (int64_t)st->timeout_ms) {
        st->interrupt_reason = 2;
        return 1;
    }
    return 0;
}

/* 把引擎异常转成 malloc 文案交回调用方（宿主据此打印；库内不再吞掉）。 */
static void set_error_out(char **err, int32_t *err_len, JSContext *ctx, JSValue ex)
{
    const char *s;
    size_t n;

    if (err == 0 || err_len == 0) {
        JS_FreeValue(ctx, ex);
        return;
    }
    *err = 0;
    *err_len = 0;
    s = JS_ToCStringLen(ctx, &n, ex);
    if (s == 0) {
        JS_FreeValue(ctx, ex);
        return;
    }
    *err = malloc(n + 1);
    if (*err != 0) {
        memcpy(*err, s, n);
        (*err)[n] = 0;
        *err_len = (int32_t)n;
    }
    JS_FreeCString(ctx, s);
    JS_FreeValue(ctx, ex);
}

int32_t eval(void *h, const char *src, int32_t len, int32_t mode,
             char **out, int32_t *out_len,
             char **err, int32_t *err_len){
    struct BackendState *st;
    char *wrapped;
    char *copy;
    const char *code;
    int32_t code_len;
    const char *s;
    size_t slen;
    int32_t i;
    int32_t prc;
    JSValue value;
    JSValue json;

    if (err != 0) *err = 0;
    if (err_len != 0) *err_len = 0;
    if (h == 0 || src == 0 || len < 0 || out == 0 || out_len == 0) return NXJB_ERR;
    st = h;
    *out = 0;
    *out_len = 0;
    /* 预算从本条消息的求值开始计时；中断原因每条消息重置。 */
    st->eval_start = now_ms();
    st->interrupt_reason = 0;

    /*
     * 进入下一条消息前先把 job 队列清空（D-05：job 清空前不处理 inbox）。
     * bootstrap 与上一条消息排下的回调都在这里生效，否则新消息会读到旧状态。
     * 泵出错不吞：job 内抛错 → 本次消息判为 NXJB_JOB_THREW，由上层累加 JS_EXCEPTIONS。
     */
    prc = pump(h, 0);
    if (prc == NXJB_JOB_THREW) return NXJB_JOB_THREW;
    if (prc < 0) return NXJB_ERR;

    /*
     * 表达式模式包一层括号：`{"id":1}` 作为脚本会被当成块语句，作为表达式才是对象字面量。
     * 程序模式（PH-11）原样求值，多语句与 `#!` 首行由引擎处理（实测引擎自己跳过 `#!`）。
     */
    wrapped = 0;
    if (mode == NXJB_MODE_PROGRAM) {
        code = src;
        code_len = len;
    } else {
        wrapped = malloc((size_t)len + 3);
        if (wrapped == 0) return NXJB_ERR;
        wrapped[0] = '(';
        i = 0;
        while (i < len) {
            wrapped[i + 1] = src[i];
            i = i + 1;
        }
        wrapped[len + 1] = ')';
        wrapped[len + 2] = 0;
        code = wrapped;
        code_len = len + 2;
    }

    value = JS_Eval(st->ctx, code, (size_t)code_len, "<message>", JS_EVAL_TYPE_GLOBAL);
    free(wrapped);
    if (JS_IsException(value)) {
        value = JS_GetException(st->ctx);
        set_error_out(err, err_len, st->ctx, value);
        /* 预算超时与宿主中断在引擎里都是 "interrupted"，这里给出可区分的文案。 */
        if (st->interrupt_reason == 2) {
            static const char TIMEOUT_MSG[] = "timeout: evaluation exceeded budget";
            char *m = malloc(sizeof(TIMEOUT_MSG));

            if (m != 0) {
                memcpy(m, TIMEOUT_MSG, sizeof(TIMEOUT_MSG));
                free(*err);
                *err = m;
                *err_len = (int32_t)(sizeof(TIMEOUT_MSG) - 1);
            }
        }
        return NXJB_ERR;
    }

    if (mode == NXJB_MODE_PROGRAM && JS_IsUndefined(value)) {
        /* 程序没有完成值（纯声明）时给宿主一个合法 JSON，而不是字符串 "undefined"。 */
        JS_FreeValue(st->ctx, value);
        json = JS_NewStringLen(st->ctx, "null", 4);
    } else {
        json = JS_JSONStringify(st->ctx, value, JS_UNDEFINED, JS_UNDEFINED);
        JS_FreeValue(st->ctx, value);
    }
    if (JS_IsException(json)) {
        json = JS_GetException(st->ctx);
        JS_FreeValue(st->ctx, json);
        return NXJB_ERR;
    }
    s = JS_ToCStringLen(st->ctx, &slen, json);
    if (s == 0) {
        JS_FreeValue(st->ctx, json);
        return NXJB_ERR;
    }
    copy = malloc(slen + 1);
    if (copy == 0) {
        JS_FreeCString(st->ctx, s);
        JS_FreeValue(st->ctx, json);
        return NXJB_ERR;
    }
    memcpy(copy, s, slen);
    copy[slen] = 0;
    *out = copy;
    *out_len = (int32_t)slen;
    JS_FreeCString(st->ctx, s);
    JS_FreeValue(st->ctx, json);
    /* 求值后泵到空：Promise 回调的副作用必须在下一条消息之前生效（D-05 顺序）。 */
    prc = pump(h, 0);
    if (prc == NXJB_JOB_THREW) return NXJB_JOB_THREW;
    if (prc < 0) return NXJB_ERR;
    return NXJB_OK;
}

int32_t shutdown(void *h)
{
    if (h == 0) return NXJB_ERR;
    /* 收尾泵：释放 runtime 前把最后一条消息排下的 job 跑掉，避免静默丢弃。 */
    (void)pump(h, NXJB_PUMP_CAP);
    free_state(h);
    return NXJB_OK;
}

void stats(void *h, int64_t *jobs, int64_t *exceptions)
{
    struct BackendState *st;

    if (h == 0) {
        if (jobs != 0) *jobs = 0;
        if (exceptions != 0) *exceptions = 0;
        return;
    }
    st = h;
    if (jobs != 0) *jobs = st->jobs;
    if (exceptions != 0) *exceptions = st->exceptions;
}

/*
 * 泵 job 队列。JS_ExecutePendingJob 返回 >0 表示跑了一个 job，0 表示空，<0 表示异常。
 * 异常必须在这里清掉：漏掉会让下一次 eval 读到脏状态（与 init 里的处理同源）。
 */
int32_t pump(void *h, int32_t max_jobs)
{
    struct BackendState *st;
    JSContext *ctx;
    JSValue ex;
    int32_t rc;
    int32_t ran;
    int32_t limit;

    if (h == 0) return NXJB_ERR;
    st = h;
    limit = max_jobs;
    if (limit <= 0) limit = NXJB_PUMP_CAP;
    ran = 0;
    ctx = 0;
    while (ran < limit) {
        rc = JS_ExecutePendingJob(st->rt, &ctx);
        if (rc < 0) {
            ex = JS_GetException(st->ctx);
            JS_FreeValue(st->ctx, ex);
            st->exceptions = st->exceptions + 1;
            return NXJB_JOB_THREW;
        }
        if (rc == 0) break;
        ran = ran + 1;
        st->jobs = st->jobs + 1;
    }
    return ran;
}
