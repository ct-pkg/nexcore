#include <stdint.h>
#include <stdlib.h>

import js_backend;

namespace js_backend;

/*
 * P1 的空后端：不链接任何 JS 引擎，依赖只有 libc。
 *
 * 语义约定：
 *   - init 返回非空句柄，使 nexcore_create 不因「没有引擎」而失败；
 *   - eval 恒返回 -1（未求值），不写 *out / *out_len；
 *   - shutdown 释放句柄，可重复调用（h == 0 时直接返回 0）。
 */
#define NXJB_ERR -1
#define NXJB_OK 0

/* 空后端无状态：句柄只要非空即可（create 据此判断「有后端」）。 */

void *init(const char *bootstrap_js, int32_t bootstrap_len,
           int32_t (*native_call)(void *user, const char *name, size_t name_len,
                                  const char *args_json, size_t args_len,
                                  char **out_json, size_t *out_len),
           void *native_user, const char *native_names, int32_t native_names_len)
{
    void *st;

    (void)bootstrap_js;
    (void)bootstrap_len;
    /* 空后端没有引擎，原生能力无从注入；忽略全部 native_* 参数。 */
    (void)native_call;
    (void)native_user;
    (void)native_names;
    (void)native_names_len;
    st = malloc(1);
    if (st == 0) return 0;
    return st;
}

int32_t eval(void *h, const char *src, int32_t len, int32_t mode, char **out, int32_t *out_len)
{
    (void)h;
    (void)src;
    (void)len;
    (void)mode;
    if (out != 0) *out = 0;
    if (out_len != 0) *out_len = 0;
    return NXJB_ERR;
}

int32_t shutdown(void *h)
{
    if (h != 0) free(h);
    return NXJB_OK;
}

void stats(void *h, int64_t *jobs, int64_t *exceptions)
{
    (void)h;
    if (jobs != 0) *jobs = 0;
    if (exceptions != 0) *exceptions = 0;
}

/* 空实现没有引擎，也就没有 job 队列。 */
int32_t pump(void *h, int32_t max_jobs)
{
    (void)h;
    (void)max_jobs;
    return 0;
}
