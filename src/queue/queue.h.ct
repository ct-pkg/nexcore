#include <stdint.h>

namespace queue;

/*
 * 不透明队列句柄：跨单元只传 void *，调用方不依赖结构布局。
 * PH-15 T1 起 open 之后的 push/pop/depth/close 可在不同线程并发调用；
 * wait 阻塞到有数据、被 wake_all 唤醒、超时或 close。
 */
pub void *open(int32_t capacity);

pub int32_t push(void *handle, const char *data, int32_t len);

/*
 * 出队：成功时 *out_data 指向 malloc 的新缓冲（内容为 push 时的字节 + NUL），
 * 所有权移交调用方，调用方负责 free。空队列返回 -4，参数非法返回 -1。
 */
pub int32_t pop(void *handle, char **out_data, int32_t *out_len);

pub int32_t depth(void *handle);

/*
 * 等待数据：timeout_ms < 0 无限等待，0 只做一次非阻塞检查，>0 最多等该毫秒数。
 * 返回 0 = 有数据（允许虚假唤醒），-4 = 超时（与空队列同码），-5 = 已关闭。
 * 只等待，不出队；数据仍由 pop 取走。
 */
pub int32_t wait(void *handle, int32_t timeout_ms);

/* 唤醒所有 wait 等待者，不释放数据；只做 cond_broadcast。 */
pub void wake_all(void *handle);

/*
 * 停止接收：置 closed 后广播唤醒所有 wait 等待者（粘性，之后 wait 返回 -5），
 * 不清空已入队数据。shutdown 用它保证阻塞中的 drain 不会丢唤醒。
 */
pub int32_t close_input(void *handle);

pub int32_t close(void *handle);
