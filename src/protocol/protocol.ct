#include <stdint.h>

import protocol;

namespace protocol;

int32_t request_well_formed(const NxRequestEnvelope *req)
{
    if (req == 0) return -1;
    if (req->id == 0) return -1;
    if (req->method == 0 || req->params_json == 0) return -1;
    if (req->params_len <= 0) return -1;
    return 0;
}

int32_t response_kind(const NxResponseEnvelope *res)
{
    if (res == 0) return -1;
    if (res->id == 0) return -1;
    if (res->result_json != 0 && res->error_code != 0) return -1;
    if (res->error_code != 0) return NX_ENV_ERROR;
    if (res->result_json != 0) return NX_ENV_RESULT;
    return -1;
}
