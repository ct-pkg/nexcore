/* 稳定 SHIM：两档共用同一份文件，recipe 指向固定的 C 符号名 */
#include "jb_backend.h"

namespace jb;

pub trait Backend {
    void * open(int32_t cap);
    int32_t eval(void * h, const char * src, int32_t len);
    int32_t turns();
    int32_t close(void * h);
}

map trait Backend for namespace jb {
    open(cap) -> js_backend_open(cap);
    eval(h, src, len) -> js_backend_eval(h, src, len);
    turns() -> js_backend_turns();
    close(h) -> js_backend_close(h);
}
