#include <stdio.h>
#include <stdint.h>

import jb::jb_map;

/* 消费者源码完全不变：只认识 jb::Backend 这个接口名。 */
int main(void)
{
    void * h = jb::Backend.open(4);
    int32_t rc = jb::Backend.eval(h, "1+1", 3);

    printf("eval=%d turns=%d\n", rc, jb::Backend.turns());
    jb::Backend.close(h);
    return 0;
}
